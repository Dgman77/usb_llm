digraph G {
rankdir=TB;
    node [shape=box, style="rounded,filled", fillcolor="#faf6ee", fontname="Arial", fontsize=12];
    edge [fontname="Arial", fontsize=11, fontcolor="#000000"];
    subgraph cluster_Trees {
        label="Trees";
        N [label="Binary Tree"];
        O [label="Root Node"];
        P [label="Left Child"];
        Q [label="Right Child"];
        R [label="Leaf Node"];
        S [label="Parent Node"];
        T [label="Grandparent Node"];
        U [label="Sibling Node"];
        V [label="Uncle Node" shape=box style="dashed"];
        W [label="Cousin Node"];
        X [label="Nephew Node"];
        Y [label="Great-grandparent Node"];
        Z [label="Aunt Node"];
        O -> P;
        O -> Q;
        P -> R;
        Q -> R;
        R -> S;
        S -> T;
        T -> U;
        U -> V;
        V -> W;
        W -> X;
        X -> Y;
        Y -> Z;
        Z -> R;
        S -> P;
        S -> Q;
        T -> P;
        T -> Q;
        U -> P;
        U -> Q;
        V -> P;
        V -> Q;
        W -> P;
        W -> Q;
        X -> P;
        X -> Q;
        Y -> P;
        Y -> Q;
        Z -> P;
        Z -> Q;
    }
}